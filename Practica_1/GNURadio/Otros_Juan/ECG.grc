- name: epy_block_0
  id: epy_block
  parameters:
    M: M
    _source_code: "import numpy as np\nfrom gnuradio import gr\n\nclass blk(gr.decim_block):\
      \   # <-- CORRECCI\xD3N: era gr.sync_decimator\n    def __init__(self, M=64):\n\
      \        gr.decim_block.__init__(   # <-- tambi\xE9n aqu\xED\n            self,\n\
      \            name='Promedios_de_tiempos',\n            in_sig=[np.float32],\n\
      \            out_sig=[np.float32],\n            decim=M\n        )\n       \
      \ self.M = M\n\n    def work(self, input_items, output_items):\n        x =\
      \ input_items[0]\n        y0 = output_items[0]\n        n_out = len(y0)\n\n\
      \        for i in range(n_out):\n            acum_x = 0.0\n            Ntotales\
      \ = 0\n\n            ventana = x[i*self.M : (i+1)*self.M]\n\n            Ntotales\
      \ += len(ventana)\n            acum_x += np.sum(ventana)\n\n            media\
      \ = acum_x / Ntotales\n            y0[i] = media\n\n        return n_out\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('Promedios_de_tiempos', 'blk', [('M', '64')], [('0', 'float', 1)],
      [('0', 'float', 1)], '', ['M'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [616, 384.0]
    rotation: 0
    state: enabled
