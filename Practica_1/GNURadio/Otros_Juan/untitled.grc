- name: epy_block_0
  id: epy_block
  parameters:
    N: '1024'
    _source_code: "import numpy as np\nfrom gnuradio import gr\n\nclass psd_autocorr(gr.sync_block):\n\
      \    \"\"\"PSD estimada v\xEDa autocorrelaci\xF3n (Wiener-Khinchin)\"\"\"\n\n\
      \    def __init__(self, N=1024, max_lag=256):\n        gr.sync_block.__init__(self,\n\
      \            name='PSD',\n            in_sig=[np.float32],\n            out_sig=[np.float32])\n\
      \        self.N = N\n        self.max_lag = max_lag\n\n    def work(self, input_items,\
      \ output_items):\n        x = input_items[0][:self.N]\n        if len(x) < self.N:\n\
      \            return 0  # esperar a tener suficientes muestras\n\n        # ---\
      \ Autocorrelaci\xF3n (equivalente a tu acumulador, pero\n        #     sumando\
      \ x[n]*x[n+lag] en vez de x[n]) ---\n        # np.correlate ya vectoriza la\
      \ suma que har\xEDa tu bloque acumulador\n        full = np.correlate(x, x,\
      \ mode='full')\n        mid = len(full) // 2\n        Rxx = full[mid: mid +\
      \ self.max_lag] / self.N\n\n        # Ventaneo opcional (reduce fuga espectral)\n\
      \        Rxx *= np.hanning(self.max_lag)\n\n        # --- PSD = FFT de la autocorrelaci\xF3\
      n ---\n        psd = np.abs(np.fft.fft(Rxx))\n        psd_db = 10 * np.log10(psd\
      \ + 1e-12)\n\n        n_out = min(len(output_items[0]), len(psd_db))\n     \
      \   output_items[0][:n_out] = psd_db[:n_out]\n        return n_out\n"
    affinity: ''
    alias: ''
    comment: ''
    max_lag: '256'
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: "('PSD', 'psd_autocorr', [('N', '1024'), ('max_lag', '256')], [('0',\
      \ 'float', 1)], [('0', 'float', 1)], 'PSD estimada v\xEDa autocorrelaci\xF3\
      n (Wiener-Khinchin)', ['N', 'max_lag'])"
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [888, 288.0]
    rotation: 0
    state: enabled
