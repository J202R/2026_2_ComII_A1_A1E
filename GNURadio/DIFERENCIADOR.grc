- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\n\nclass blk(gr.sync_block):\n\
      \n    def __init__(self):  \n        gr.sync_block.__init__(\n            self,\n\
      \            name='e_Diff',   \n            in_sig=[np.float32],\n         \
      \   out_sig=[np.float32]\n        ) # <-- El par\xE9ntesis de cierre va aqu\xED\
      \n\n        # Memoria para guardar la \xFAltima muestra del bloque de datos\
      \ anterior\n        self.muestra_anterior = 0.0\n\n    def work(self, input_items,\
      \ output_items):\n        x = input_items[0]   # Se\xF1al de entrada\n     \
      \   y0 = output_items[0] # Se\xF1al de salida diferencial\n        \n      \
      \  if len(x) == 0:\n            return 0\n\n        # Para derivar, insertamos\
      \ la \xFAltima muestra del paquete anterior al inicio\n        x_completo =\
      \ np.insert(x, 0, self.muestra_anterior)\n        \n        # np.diff calcula\
      \ la diferencia entre elementos adyacentes: x[n] - x[n-1]\n        y0[:] = np.diff(x_completo)\n\
      \        \n        # Guardamos la \xFAltima muestra actual para usarla en el\
      \ siguiente ciclo\n        self.muestra_anterior = x[-1]\n        \n       \
      \ return len(y0) # <-- Corregido: len(y0)"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('e_Diff', 'blk', [], [('0', 'float', 1)], [('0', 'float', 1)], '',
      [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [480, 272.0]
    rotation: 0
    state: enabled
- name: epy_block_0_0
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\n\nclass blk(gr.sync_block):\n\
      \n    def __init__(self):  \n        gr.sync_block.__init__(\n            self,\n\
      \            name='e_Diff',   \n            in_sig=[np.float32],\n         \
      \   out_sig=[np.float32]\n        ) # <-- El par\xE9ntesis de cierre va aqu\xED\
      \n\n        # Memoria para guardar la \xFAltima muestra del bloque de datos\
      \ anterior\n        self.muestra_anterior = 0.0\n\n    def work(self, input_items,\
      \ output_items):\n        x = input_items[0]   # Se\xF1al de entrada\n     \
      \   y0 = output_items[0] # Se\xF1al de salida diferencial\n        \n      \
      \  if len(x) == 0:\n            return 0\n\n        # Para derivar, insertamos\
      \ la \xFAltima muestra del paquete anterior al inicio\n        x_completo =\
      \ np.insert(x, 0, self.muestra_anterior)\n        \n        # np.diff calcula\
      \ la diferencia entre elementos adyacentes: x[n] - x[n-1]\n        y0[:] = np.diff(x_completo)\n\
      \        \n        # Guardamos la \xFAltima muestra actual para usarla en el\
      \ siguiente ciclo\n        self.muestra_anterior = x[-1]\n        \n       \
      \ return len(y0) # <-- Corregido: len(y0)"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('e_Diff', 'blk', [], [('0', 'float', 1)], [('0', 'float', 1)], '',
      [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [552, 488.0]
    rotation: 0
    state: enabled
- name: epy_block_0_1
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\n\nclass blk(gr.sync_block):\n\
      \n    def __init__(self):    # Doble guion bajo\n        gr.sync_block.__init__(\n\
      \            self,\n            name='e_Acum',    \n            in_sig=[np.float32],\n\
      \            out_sig=[np.float32]\n        )\n        # Estado de memoria: guarda\
      \ el \xFAltimo valor del bloque anterior\n        self.valor_anterior = 0.0\n\
      \n    def work(self, input_items, output_items):\n        x = input_items[0]\
      \    # Se\xF1al de entrada\n        y0 = output_items[0]  # Se\xF1al de salida\n\
      \n        # Calculamos la suma acumulada y le sumamos el estado anterior\n \
      \       y0[:] = self.valor_anterior + np.cumsum(x)\n        \n        # Guardamos\
      \ el \xFAltimo valor de este bloque para usarlo en el siguiente\n        if\
      \ len(y0) > 0:\n            self.valor_anterior = y0[-1]\n\n        return len(y0)\
      \  # Retornamos len(y0) en lugar de len(y)"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('e_Acum', 'blk', [], [('0', 'float', 1)], [('0', 'float', 1)], '',
      [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [544, 744.0]
    rotation: 0
    state: enabled
